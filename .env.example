POSTGRES_PASSWORD=change_me_local_only
# Docker Compose sets DATABASE_URL for the API. Without Docker, SQLite is the default.
# DATABASE_URL=postgresql+psycopg://trading:password@127.0.0.1:55432/trading
FRONTEND_URL=http://127.0.0.1:5173
SECURE_COOKIES=false
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true
# Reserved for later adapters; never prefix secrets with VITE_.
MARKET_DATA_API_KEY=
AI_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=
JWT_SECRET=
